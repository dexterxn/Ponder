rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cover images are stored at covers/{userId}/{bookId}.{ext}.
    // Only the owning user can read or write their covers, and uploads
    // must be small images.
    match /covers/{userId}/{file=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/jpeg')
            || request.resource.contentType.matches('image/png')
            || request.resource.contentType.matches('image/gif')
            || request.resource.contentType.matches('image/webp')
            || request.resource.contentType.matches('image/heic')
            || request.resource.contentType.matches('image/heif'));
    }
  }
}
